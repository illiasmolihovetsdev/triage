# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/versions

# next.js
.next/
out/
build/
next-env.d.ts

# prisma generated client (regenerated by `prisma generate` during build)
/generated
prisma/generated/
src/generated/

# environment
# Ignore every .env variant, including ad-hoc backups such as .env.bak, so a
# stray copy of real credentials can never be committed. .env.example is the
# single deliberate exception: it documents the required variables with no
# real values.
.env*
!.env.example

# testing
coverage/

# vercel
.vercel

# typescript
*.tsbuildinfo

# certificates
*.pem

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# os
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Local-only: private task material, IDE settings, and AI assistant config.
# These describe how this machine is set up, not how the project works, so
# they stay out of the published repository.
# ---------------------------------------------------------------------------

